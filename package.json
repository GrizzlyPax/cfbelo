{
  "name": "cfbelo",
  "version": "0.1.0",
  "description": "A ranking-system laboratory for college football — design a FIFA/Elo-style rating system and backtest it against historical seasons.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "backtest": "tsx cli/backtest.ts",
    "ingest": "tsx jobs/ingest.ts",
    "update": "tsx jobs/update.ts",
    "demo-data": "tsx jobs/make-demo-season.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
