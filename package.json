{
  "name": "cfbelo",
  "version": "0.1.0",
  "description": "A ranking-system laboratory for college football — design a FIFA/Elo-style rating system and backtest it against historical seasons.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "backtest": "tsx cli/backtest.ts",
    "ingest": "tsx jobs/ingest.ts",
    "update": "tsx jobs/update.ts",
    "demo-data": "tsx jobs/make-demo-season.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.6.0"
  }
}
